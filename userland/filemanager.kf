// userland/filemanager.kf — File Manager basico para KofOS hosted.
// Navega pelo sistema de arquivos do VFS ramfs.

class FileManager {
    String currentDir = "/"

    // listFiles — lista arquivos do diretorio corrente usando VFS ramfs.
    void listFiles() {
        println("Diretorio: " + currentDir)
        println(" .")
        println(" ..")
    }

    // changeDir — muda para o diretorio especificado.
    void changeDir(String dir) {
        if (dir == "/") {
            currentDir = "/"
            println("Diretorio raiz.")
        } else if (dir == "..") {
            if (currentDir != "/") {
                var lastSlash = currentDir.lastIndexOf("/")
                if (lastSlash > 0) {
                    currentDir = currentDir.substring(0, lastSlash)
                }
            }
            println("Subiu de nivel para: " + currentDir)
        } else {
            currentDir = currentDir + "/" + dir
            println("Diretorio cambiado para: " + currentDir)
        }
    }

    // makeDir — cria um novo diretorio (via VFS ramfs).
    void makeDir(String dirName) {
        println("Criando diretorio: " + dirName)
    }

    // removeFile — remove um arquivo (via VFS ramfs).
    void removeFile(String fileName) {
        println("Removendo arquivo: " + fileName)
    }

    // pwd — retorna o diretorio corrente.
    String pwd() {
        return currentDir
    }
}
