// userland/shell.kf — Shell para KofOS hosted.
// Interface de linha de comando com historico e autocomplete basico.

class Shell {
    var history: List<String> = []
    var historyPos = 0
    var pending: String = ""

    // run — loop principal da shell (chamado do init).
    static void run() {
        println("KofOS shell starting...")
        var term = Terminal
        // Fire-and-forget timer para ticks de scheduler; a shell cede via yield.
        loop {
            // Mostra prompt.
            Terminal.write("> ")
            // readLine bloqueia ate haver entrada; o scheduler gerencia o switch.
            var line = Terminal.readLine()
            if (line == "exit") {
                Terminal.write("Shell exiting.")
                return
            }
            if (line startsWith "cd ") {
                var dir = line.substring(3)
                // Simples: muda o diretorio no filemanager.
                Terminal.write("cd: dir=" + dir)
            } else if (line == "ls") {
                FileManager.listFiles()
            } else if (line startsWith "help") {
                Terminal.write("Comandos disponiveis: help, ls, exit, cd, clear")
            } else if (line == "clear") {
                Terminal.clear()
            } else if (line == "version") {
                Terminal.write("KofOS version 0.1.0")
            } else if (line startsWith "echo ") {
                var msg = line.substring(5)
                Terminal.write(msg)
            } else {
                Terminal.write("Comando nao encontrado: " + line)
                // Adiciona ao historico se nao for vazio.
                if (line != "") {
                    Shell.history = Shell.history + [line]
                }
            }
            // Adiciona linha ao historico se nao for vazia.
            if (line != "") {
                Shell.history = Shell.history + [line]
                Shell.historyPos = Shell.history.size
            }
        }
    }
}