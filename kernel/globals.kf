// kernel/globals.kf — Estado global do kernel KofOS (hosted).
//
// O VibeOS usa globals C + arrays fixos. Em Kof, o estado global do kernel
// vive em campos estáticos desta classe Kernel. (Kof não tem top-level
// val/var; classes com static são o mecanismo idiomático — ver training.)

import kernel.hal
import kernel.process

// Kernel — singleton de estado do kernel KofOS.
class Kernel {
    // HAL instances (setados no boot via kernel_hal_init).
    static HAL_timer? timer = null
    static HAL_video? video = null
    static HAL_input? input = null
    static HAL_storage? storage = null

    // Boot/estado.
    static Bool bootComplete = false
    static Bool preemptionReady = false
    static Int nextPid = 1

    // Processos (scheduler).
    static Process? idle = null
    static Process? current = null

    // allocate_pid — aloca um pid sequencial (espelha o alocador do VibeOS).
    static Int allocatePid() {
        val pid = Kernel.nextPid
        Kernel.nextPid = Kernel.nextPid + 1
        return pid
    }
}