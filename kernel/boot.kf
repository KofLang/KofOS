// kernel/boot.kf — Entry point do kernel (port de kernel/entry.c).
//
// O VibeOS define `kernel_entry` em .entry no endereco 0x10000, chamado pelo
// stage2 via jmp far. No KofOS (kernel hosted, gap HW001) kernel_entry eh a
// primeira fase do boot, chamada por Main.kf. A ordem de inicializacao
// espelha fielmente kernel/entry.c do VibeOS.

import kernel.hal
import kernel.kernel_init

// Console de texto do boot (porta para kernel_text_puts do VibeOS).
class BootLog {
    static String buffer = ""

    static void puts(String s) {
        println(s)
        buffer = buffer + s + "\n"
    }
}

// BootGlobals — estado global do boot (globals do kernel em Kof).
class BootGlobals {
    static Bool bssZeroed = false
    static Bool debugInit = false
    static Bool halReady = false
    static Bool memoryReady = false
    static Bool schedulerReady = false
    static Bool syscallsReady = false
    static List<String>? trace = null

    static void mark(String phase) {
        if (trace == null) {
            trace = listOf()
        }
        trace.add(phase)
    }
}

// kernel_entry — fase de boot do kernel. Espelha kernel/entry.c:305.
void kernel_entry() {
    BootGlobals.mark("kernel_entry")

    // 1. debug init + launch/service init
    BootGlobals.debugInit = true
    BootGlobals.mark("debug_init")

    // 2. hal init
    kernel_hal_init()
    // kernel_scheduler_init() — desabilitado temporariamente
    BootGlobals.halReady = true
    BootGlobals.mark("hal_init")

    // 3. cpu/gdt (simulado no hosted: single processor)
    BootLog.puts("CPU topology: single processor")
    BootGlobals.mark("cpu_gdt")

    // 4. video + text
    BootLog.puts("VIBE OS Booting...")
    BootLog.puts("Video OK")
    BootGlobals.mark("video")

    // 5. interrupts (IDT/PIC simulados — gap HW001)
    BootLog.puts("Setting up interrupts...")
    BootLog.puts("Interrupts OK")
    BootGlobals.mark("interrupts")

    // 6. timers/input
    BootLog.puts("Starting timers/input...")
    kernel_timer_init(BootConsts.PIT_HZ)
    kernel_keyboard_init()
    kernel_mouse_init()
    BootLog.puts("IRQ OK")
    BootGlobals.mark("timer_input")

    // 7. memory
    BootLog.puts("Initializing memory...")
    kernel_memory_init()
    BootLog.puts("Memory OK")
    BootGlobals.memoryReady = true
    BootGlobals.mark("memory")

    // 8. storage
    BootLog.puts("Initializing storage...")
    kernel_storage_init()
    BootLog.puts("Storage OK")
    BootGlobals.mark("storage")

    // 9. scheduler + driver manager (disabled — bytecode putfield gap)
    BootLog.puts("Initializing scheduler/driver manager...")
    // kernel_scheduler_init()
    // BootLog.puts("Scheduler OK")
    // BootGlobals.schedulerReady = true
    // BootGlobals.mark("scheduler")

    // 10. VFS + services microkernel
    BootLog.puts("Initializing VFS...")
    kernel_vfs_init()
    kernel_services_init()
    BootLog.puts("VFS OK")
    BootGlobals.mark("vfs_services")

    // 11. syscalls
    BootLog.puts("Initializing syscalls...")
    kernel_syscall_init()
    BootLog.puts("Syscalls OK")
    BootGlobals.syscallsReady = true
    BootGlobals.mark("syscalls")

    // 12. userland
    BootLog.puts("Starting userland...")
    kernel_userland_run()
    BootGlobals.mark("userland")

    BootLog.puts("KofOS boot complete")
    BootGlobals.mark("done")
}