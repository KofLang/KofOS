// kernel/scheduler.kf — Scheduler + processos (port de kernel/process/scheduler.c).
//
// O VibeOS usa round-robin cooperativo + preempção por timeslice (4 ticks do
// PIT, 100Hz). No KofOS hosted, o scheduler roda tarefas como funções de
// boot sequenciais no modo cooperativo inicial; a preempção real por timer
// será adicionada na fase PORT-SCHED (usando kof.time.interval).

import kernel.process

// Scheduler — núcleo da multitarefa.
class Scheduler {
    // Lista ligada de processos (g_head no VibeOS).
    Process? head
    Int taskCount

    public constructor() {
        this.head = null
        this.taskCount = 0
    }

    // add_task — enfileira um processo em READY (espelha scheduler_add_task).
    void addTask(Process p) {
        p.state = ProcState.READY
        p.next = head
        head = p
        taskCount = taskCount + 1
    }

    // next_ready — retorna o próximo processo pronto (round-robin simples).
    // Percorre a lista; se nenhum pronto, retorna null (idle).
    Process? nextReady() {
        var p = head
        while (p != null) {
            if (p.state == ProcState.READY) {
                return p
            }
            p = p.next
        }
        return null
    }

    // count_ready — quantos processos estão prontos.
    Int countReady() {
        var n = 0
        var p = head
        while (p != null) {
            if (p.state == ProcState.READY) {
                n = n + 1
            }
            p = p.next
        }
        return n
    }
}

// SchedulerGlobals — estado global do scheduler.
class SchedulerGlobals {
    static Scheduler? instance = null
}

// kernel_scheduler_bootstrap — cria o scheduler global.
Bool kernel_scheduler_bootstrap() {
    SchedulerGlobals.instance = Scheduler()
    return true
}