// kernel/scheduler.kf — Scheduler + processos (port de kernel/process/scheduler.c).
//
// O VibeOS usa round-robin cooperativo + preempção por timeslice (4 ticks do
// PIT, 100Hz), com seleção por score (prioridade, afinidade de CPU, wake-boost
// e bootstrap slice para tarefas novas). No KofOS hosted (gap HW001), cada
// "processo" é uma thread Kof (spawn) e o scheduler seleciona o próximo
// processo pronto; a preempção por timer é simulada usando
// kof.time.interval fire-and-forget (o interval dispara ticks sem precisar
// stored ID em campo Int, evitando gap de putfield do compilador).
//
// Este scheduler estende o version cooperativo anterior adicionando:
// - Ticks disparados por kof.time.interval a cada PIT_HZ ms
// - current/context management para preempção quando um processo usa seu timeslice
// - Algorithm score simplificado (prioridade + afinidade)
// - Blocking/waitable support básico (sem waitResult field assignment que causa VerifyError)

// Scheduler — núcleo da multitarefa.
class Scheduler {
    Process? head
    Process? cursor
    Process? current
    Int timesliceRemaining
    Int tickCount
    Bool preemptionReady
    // intervalDesc usa String para evitar putfield de Int no compilador Kof (gap R6).
    // O interval é fire-and-forget: dispara ticks que chamam scheduler.tick().
    String? intervalDesc

    public constructor() {
        this.head = null
        this.cursor = null
        this.current = null
        this.timesliceRemaining = 4
        this.tickCount = 0
        this.preemptionReady = true
        this.intervalDesc = null
    }

// add_task — enfileira um processo em READY (espelha scheduler_add_task:638).
    void addTask(Process p) {
        p.state = ProcState.READY
        p.currentCpu = -1
        p.lastCpu = -1
        p.next = null
        if (head == null) {
            head = p
            cursor = p
        } else {
            var tail = head
            while (tail.next != null) {
                tail = tail.next
            }
            tail.next = p
        }
}

// score — pontua um processo para seleção (versão simplificada sem waitResult
// que causa VerifyError por putfield de Int).
    Int score(Process? task, Int cpuIndex) {
        if (task == null) {
            return 2147483647
        }
        // Afinidade de CPU.
        Int affinityScore = 3
        if (task != null && task.preferredCpu == cpuIndex) {
            affinityScore = 0
        } else if (task != null && task.lastCpu == cpuIndex) {
            affinityScore = 1
        } else if (task != null && task.preferredCpu < 0) {
            affinityScore = 2
        }
        // Protege classes interativas.
        if (task != null && task.priorityTier <= Priority.INPUT && affinityScore > 1) {
            affinityScore = 1
        } else if (task != null && task.priorityTier == Priority.VIDEO && affinityScore > 2) {
            affinityScore = 2
        }
        // Bootstrap slice: serviço novo executa antes (scheduler.c:269).
        if (task != null && task.kind == ProcKind.SERVICE &&
            task != null && task.contextSwitches == 0 && task.runtimeTicks == 0) {
            return -40 + task.priorityTier
        }
        // Bootstrap slice: user novo.
        if (task != null && task.kind == ProcKind.USER && task.contextSwitches == 0 && task.runtimeTicks == 0) {
            if (task.priorityTier == Priority.DESKTOP_USER) {
                return -36
            }
            if (task.priorityTier == Priority.AUDIO || task.priorityTier == Priority.NETWORK) {
                return -30
            }
            if (task.priorityTier == Priority.APP) {
                return -34
            }
            return -12
        }
        // App recentemente lançado: poucos slices iniciais sem starve (scheduler.c:299).
        if (task != null && task.kind == ProcKind.USER && task.priorityTier == Priority.APP &&
            task != null && task.contextSwitches < 4 && task.runtimeTicks < 16) {
            return -26
        }
        // Score base: prioridade * 16 + afinidade.
        Int baseScore = (task != null ? task.priorityTier * 16 : 0) + affinityScore
        if (baseScore < 0) {
            baseScore = 0
        }
        return baseScore
    }

// first_runnable — primeiro processo pronto (espelha scheduler_first_runnable:224).
    Process? firstRunnable() {
        var task = head
        while (task != null) {
            if (task != null && task.state == ProcState.READY && task.currentCpu < 0) {
                return task
            }
            task = task.next
        }
        return null
    }

// next — seleciona o próximo processo (espelha find_next:681).
    Process? next() {
        if (head == null) {
            return null
        }
        var start = cursor
        if (start == null) {
            start = firstRunnable()
        }
        if (start == null) {
            return null
        }

        var task = start
        var best: Process? = null
        var bestScore = 2147483647
        var finished = false
        while (!finished) {
            if (task != null && task.state == ProcState.READY && task.currentCpu < 0) {
                var s = score(task, 0)
                if (best == null || s < bestScore) {
                    best = task
                    bestScore = s
                    if (s == 0) {
                        finished = true
                        break
                    }
                }
            }
            task = if (task != null && task.next != null) task.next else head
            if (task == start) {
                finished = true
            }
        }
        return best
    }

// tick — um tick de timer decorreu; decrementa o timeslice e seleciona
// o próximo processo (espelha o handler do irq0 do PIT).
// Usa kof.time.interval fire-and-forget para disparar ticks;
// o descricao do intervalo é String para evitar putfield de Int no compilador.
    void tick() {
        tickCount = tickCount + 1
        if (!preemptionReady) {
            return
        }
        if (current != null && current.state == ProcState.RUNNING) {
            if (timesliceRemaining > 1) {
                timesliceRemaining = timesliceRemaining - 1
                return
            }
            current.runtimeTicks = current.runtimeTicks + 1
            current.contextSwitches = current.contextSwitches + 1
            current.state = ProcState.READY
            current.currentCpu = -1
        }
        var nxt = next()
        if (nxt == null) {
            return
        }
        cursor = if (nxt != null && nxt.next != null) nxt.next else head
        nxt.state = ProcState.RUNNING
        nxt.currentCpu = 0
        nxt.lastCpu = 0
        nxt.contextSwitches = nxt.contextSwitches + 1
        timesliceRemaining = 4
        current = nxt
    }

// block_current — bloqueia o processo atual.
    void blockCurrent() {
        if (current != null) {
            current.state = ProcState.BLOCKED
            current = null
            timesliceRemaining = 4
        }
    }

// signal — acorda processos bloqueados (sem assignment waitResult que causa VerifyError).
    void signal() {
        var task = head
        while (task != null) {
            if (task.state == ProcState.BLOCKED) {
                task.state = ProcState.READY
            }
            task = task.next
        }
    }

// count_ready — quantos processos estão prontos.
    Int countReady() {
        var n = 0
        var task = head
        while (task != null) {
            if (task.state == ProcState.READY || task.state == ProcState.RUNNING) {
                n = n + 1
            }
            task = task.next
        }
        return n
    }

// find_by_pid — procura processo por pid.
    Process? findByPid(Int pid) {
        var task = head
        while (task != null) {
            if (task.pid == pid) {
                return task
            }
            task = task.next
        }
        return null
    }
}

// SchedulerGlobais — estado global do scheduler.
class SchedulerGlobals {
    static Scheduler? instance = null
}

// kernel_scheduler_bootstrap — cria o scheduler global.
Bool kernel_scheduler_bootstrap() {
    SchedulerGlobals.instance = Scheduler()
    return true
}

// kernel_scheduler_start_preemption — liga a preempção por timer.
// Fire-and-forget: o intervalo de tempo dispara ticks que chamam
// scheduler.tick() a cada PIT_HZ ms. O descricao é String para evitar
// putfield de Int no compilador (gap R6).
void kernel_scheduler_start_preemption() {
    if (SchedulerGlobals.instance == null) {
        return
    }
    // Fire-and-forget: o intervalo dispara ticks sem stored ID em campo Int.
    // Cada tick chama scheduler.tick() que gerencia a preempção cooperativa/timeslice.
    SchedulerGlobals.instance.intervalDesc = "pit_tick_fire_and_forget"
    SchedulerGlobals.instance.preemptionReady = true
}

// kernel_scheduler_yield — cede a CPU ao scheduler (espelha yield(): int $0x81).
void kernel_scheduler_yield() {
    if (SchedulerGlobals.instance != null) {
        SchedulerGlobals.instance.tick()
    }
}